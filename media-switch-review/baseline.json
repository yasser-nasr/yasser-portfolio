      "file": "src/app/robots.ts",
      "text": "import type { MetadataRoute } from \"next\";\nimport { productionSiteUrl } from \"@/lib/site\";\n\nexport default function robots(): MetadataRoute.Robots {\n  return {\n    rules: {\n      userAgent: \"*\",\n      allow: \"/\",\n    },\n    sitemap: `${productionSiteUrl}/sitemap.xml`,\n  };\n}\n"
