      "text": "import { profile } from \"@/data/profile\";\r\n\r\nexport const heroContent = {\r\n  tagline: \"Every Great Visual Starts with a Pixel\",\r\n  name: profile.name,\r\n  title: profile.primaryTitle,\r\n  statement:\r\n    \"With 6+ years of experience creating brand identities, visual systems, digital campaigns, websites, landing pages, presentations, motion content, social media visuals, and marketing materials for agencies and businesses across Egypt and GCC markets.\",\r\n  availability: \"Available for opportunities across GCC and international markets\",\r\n  primaryCta: { label: \"Explore Selected Work\", href: \"/work\" },\r\n  secondaryCta: { label: \"About Me\", href: \"/about\" },\r\n};\r\n"
