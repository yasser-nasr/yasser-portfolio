      "file": "src/data/journey.ts",
      "text": "export type JourneyStage = {\n  title: string;\n  description: string;\n};\n\nexport const journeyStages: JourneyStage[] = [\n  {\n    title: \"Foundation\",\n    description:\n      \"Started through freelance design and independent creative work, developing strong foundations in graphic design, visual communication, and client collaboration.\",\n  },\n  {\n    title: \"Multidisciplinary Growth\",\n    description:\n      \"Expanded across brand identity, advertising, print, campaigns, presentations, motion, and digital content for different industries and organizations.\",\n  },\n  {\n    title: \"GCC & Remote Experience\",\n    description:\n      \"Collaborated remotely with agencies, companies, and growing brands across the UAE, Saudi Arabia, Egypt, and wider GCC markets.\",\n  },\n  {\n    title: \"Brand & Digital Direction\",\n    description:\n      \"Progressed into broader responsibility across brand systems, websites, digital experiences, multimedia, marketing communication, and complete project ownership.\",\n  },\n];\n\nexport const mentoringHighlight =\n  \"150+ designers mentored through graphic design programs and workshops.\";\n"
