      "file": "src/app/globals.css",
      "text": "@import \"tailwindcss\";\n\n/* Both themes follow the device preference by default. Explicit attributes\n   allow the existing toggle to override the theme for the current visit. */\n:root,\nhtml[data-theme=\"dark\"] {\n  --bg-main: #1D1D1B;\n  --bg-deep: #242424;\n  --bg-card: #2F2F2D;\n  --border: #3A3A38;\n  --text-main: #F2F0EA;\n  --text-secondary: #B8B8B2;\n  --text-muted: #A09F99;\n  color-scheme: dark;\n}\n\nhtml[data-theme=\"light\"] {\n  --bg-main: #E8E5DD;\n  --bg-deep: #DEDAD0;\n  --bg-card: #F2F0EA;\n  --border: #C8C3B8;\n  --text-main: #151515;\n  --text-secondary: #4A4A46;\n  --text-muted: #625E56;\n  color-scheme: light;\n}\n\n@media (prefers-color-scheme: light) {\n  html:not([data-theme]) {\n    --bg-main: #E8E5DD;\n    --bg-deep: #DEDAD0;\n    --bg-card: #F2F0EA;\n    --border: #C8C3B8;\n    --text-main: #151515;\n    --text-secondary: #4A4A46;\n    --text-muted: #625E56;\n    color-scheme: light;\n  }\n}\n\n@theme inline {\n  --color-surface: var(--bg-main);\n  --color-surface-deep: var(--bg-deep);\n  --color-surface-card: var(--bg-card);\n  --color-edge: var(--border);\n  --color-ink: var(--text-main);\n  --color-ink-soft: var(--text-secondary);\n  --color-ink-faint: var(--text-muted);\n  --font-sans: var(--font-poppins);\n  --font-display: var(--font-alpharush);\n}\n\nhtml {\n  scroll-behavior: smooth;\n  overflow-x: hidden;\n}\n\nbody {\n  min-height: 100%;\n  overflow-x: hidden;\n  background: var(--bg-main);\n  color: var(--text-main);\n  font-family: var(--font-sans), system-ui, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n  transition: background-color 0.25s ease, color 0.25s ease;\n}\n\n/* The wordmark SVG is a static light-on-transparent asset. Inverting maps\n   its fill to the near-exact light-theme ink value without duplicating\n   artwork or baking theme colors into the file. The pixel mascot is exempt\n   on purpose — it keeps its original dark-mode colors in both themes as a\n   fixed brand signature. */\n.brand-mark {\n  transition: filter 0.25s ease;\n}\n\nhtml[data-theme=\"light\"] .brand-mark {\n  filter: invert(1);\n}\n\n@media (prefers-color-scheme: light) {\n  html:not([data-theme]) .brand-mark {\n    filter: invert(1);\n  }\n}\n\n::selection {\n  background: #245fc7;\n  color: #ffffff;\n  text-shadow: none;\n}\n\n::-moz-selection {\n  background: #245fc7;\n  color: #ffffff;\n  text-shadow: none;\n}\n\n:focus-visible {\n  outline: 2px solid var(--text-main);\n  outline-offset: 3px;\n  border-radius: 2px;\n}\n\n/* Shared depth layer: one layered surface + soft radial light field + faint grain,\n   rendered once behind every page instead of per-section. */\n.background-field {\n  position: fixed;\n  inset: 0;\n  z-index: -1;\n  pointer-events: none;\n  background-color: var(--bg-main);\n  background-image:\n    radial-gradient(60% 50% at 80% 0%, color-mix(in srgb, var(--bg-card) 70%, transparent) 0%, transparent 70%),\n    radial-gradient(45% 40% at 10% 100%, color-mix(in srgb, var(--bg-deep) 80%, transparent) 0%, transparent 70%);\n}\n\n.background-field::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  opacity: 0.05;\n  background-repeat: repeat;\n  background-size: 160px 160px;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>\");\n  mix-blend-mode: overlay;\n}\n\n/* Floating glass dock for the proof strip: restrained translucent charcoal,\n   a thin light rim, a soft diffused shadow for lift, and a faint inset top\n   highlight to read as a glass edge rather than a flat card. */\n.proof-dock {\n  background: color-mix(in srgb, var(--bg-card) 75%, transparent);\n  border: 1px solid color-mix(in srgb, var(--text-main) 14%, transparent);\n  box-shadow:\n    0 24px 48px -16px rgba(0, 0, 0, 0.45),\n    inset 0 1px 0 0 color-mix(in srgb, var(--text-main) 10%, transparent);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n"
    },
