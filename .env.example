# Resend API key - create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered (your inbox)
CONTACT_TO_EMAIL=

# Must be a verified sender on your Resend domain, e.g. "Website Contact <contact@yassernasr.com>"
CONTACT_FROM_EMAIL=

# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX" (https://analytics.google.com)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID (https://clarity.microsoft.com)
NEXT_PUBLIC_CLARITY_ID=

# Canonical production origin. Localhost values are ignored in production.
NEXT_PUBLIC_SITE_URL=https://yassernasr.com
